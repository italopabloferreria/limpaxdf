{
  "name": "limpax",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "qa:recovery": "node scripts/verify-local-backup.mjs",
    "qa:preflight": "node scripts/release-preflight.mjs",
    "qa:crm-network": "node scripts/test-crm-network.mjs",
    "qa:customer-network": "node scripts/test-customer-network.mjs",
    "qa:supabase-adapter": "node scripts/test-supabase-adapter.mjs",
    "qa:supabase-auth-readiness": "node scripts/check-supabase-auth-readiness.mjs",
    "qa:supabase-homologation": "node scripts/validate-supabase-homologation.mjs",
    "qa:remote-readiness": "node scripts/remote-release-readiness.mjs",
    "qa:remote-evidence": "node scripts/remote-evidence-check.mjs",
    "qa:remote-checks": "node --test scripts/test-remote-g13-checks.mjs",
    "qa:supabase-local": "node scripts/check-supabase-local.mjs",
    "qa:supabase-session": "node scripts/test-supabase-homologation.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.58.0",
    "@cloudflare/workers-types": "5.20260924.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "playwright": "1.63.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.11",
    "vite": "8.3.0",
    "wrangler": "4.137.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
